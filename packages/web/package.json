{
  "name": "@akta/txn-graph-web",
  "version": "0.2.0",
  "description": "Web renderer for the Akita txn-graph visualizer. DOM + SVG + Motion — zero React Native dependencies.",
  "license": "MIT",
  "keywords": [
    "algorand",
    "motion",
    "react",
    "svg",
    "transaction-graph",
    "visualizer"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src/ --fix",
    "build:types": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build:types"
  },
  "dependencies": {
    "@akta/txn-graph-core": "workspace:^"
  },
  "peerDependencies": {
    "motion": ">=12.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "motion": "^12.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "./package.json": "./package.json"
    }
  }
}
