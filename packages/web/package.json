{
  "name": "@akta/txn-graph-web",
  "version": "0.1.0",
  "description": "Web renderer for the Akita txn-graph visualizer. DOM + SVG + Motion — zero React Native dependencies.",
  "license": "MIT",
  "keywords": [
    "algorand",
    "transaction-graph",
    "visualizer",
    "svg",
    "motion",
    "react"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src/ --fix"
  },
  "peerDependencies": {
    "@akta/txn-graph-core": "workspace:*",
    "motion": ">=12.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@akta/txn-graph-core": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "motion": "^12.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
