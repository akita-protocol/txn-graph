{
  "name": "@akta/txn-graph-rn",
  "version": "0.2.1",
  "description": "React Native renderer for the Akita txn-graph visualizer. Built on react-native-svg + Reanimated + Gesture Handler.",
  "license": "MIT",
  "keywords": [
    "algorand",
    "react-native",
    "react-native-svg",
    "reanimated",
    "transaction-graph",
    "visualizer"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src/ --fix",
    "prepack": "pnpm build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@akta/txn-graph-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-svg": "15.12.1",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "react-native": "./dist/index.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
