{
  "name": "@akta/txn-graph-rn",
  "version": "0.1.0",
  "description": "React Native renderer for the Akita txn-graph visualizer. Built on react-native-svg + Reanimated + Gesture Handler.",
  "license": "MIT",
  "keywords": [
    "algorand",
    "transaction-graph",
    "visualizer",
    "react-native",
    "react-native-svg",
    "reanimated"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src/ --fix"
  },
  "peerDependencies": {
    "@akta/txn-graph-core": "workspace:*",
    "react": ">=18.2.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@akta/txn-graph-core": "workspace:*",
    "@types/react": "^19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-svg": "15.12.1",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
