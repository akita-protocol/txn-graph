{
  "name": "@akita-protocol/txn-graph-core",
  "version": "0.2.1",
  "description": "Platform-neutral core for the Akita txn-graph visualizer: graph building, drill-down scopes, layout, theme tokens, data provider, and the useTxnGraph controller — shared by @akita-protocol/txn-graph-web and @akita-protocol/txn-graph-rn.",
  "license": "MIT",
  "keywords": [
    "algorand",
    "dagre",
    "transaction-graph",
    "visualizer"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./lora-adapter": {
      "source": "./src/lora-adapter.ts",
      "types": "./src/lora-adapter.ts",
      "import": "./src/lora-adapter.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src/ --fix",
    "prepack": "pnpm build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "19.1.0",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./lora-adapter": {
        "types": "./dist/lora-adapter.d.ts",
        "import": "./dist/lora-adapter.js",
        "default": "./dist/lora-adapter.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akita-protocol/txn-graph.git",
    "directory": "packages/core"
  }
}
