{
  "name": "@akita/visual-explorer",
  "version": "0.1.0",
  "description": "Cross-platform React / React Native visualizer for Algorand transaction groups.",
  "license": "MIT",
  "keywords": [
    "algorand",
    "visualizer",
    "transaction-graph",
    "react-native",
    "react",
    "dagre",
    "reanimated",
    "react-native-svg"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/",
    "tailwind.preset.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./models": {
      "source": "./src/models/index.ts",
      "types": "./src/models/index.ts",
      "react-native": "./src/models/index.ts",
      "import": "./src/models/index.ts"
    },
    "./mappers": {
      "source": "./src/mappers/index.ts",
      "types": "./src/mappers/index.ts",
      "react-native": "./src/mappers/index.ts",
      "import": "./src/mappers/index.ts"
    },
    "./layouts": {
      "source": "./src/layouts/index.ts",
      "types": "./src/layouts/index.ts",
      "react-native": "./src/layouts/index.ts",
      "import": "./src/layouts/index.ts"
    },
    "./primitives": {
      "source": "./src/primitives/index.ts",
      "types": "./src/primitives/index.ts",
      "react-native": "./src/primitives/index.ts",
      "import": "./src/primitives/index.ts"
    },
    "./theme": {
      "source": "./src/theme/index.ts",
      "types": "./src/theme/index.ts",
      "react-native": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    },
    "./lora-adapter": {
      "source": "./src/lora-adapter/index.ts",
      "types": "./src/lora-adapter/index.ts",
      "import": "./src/lora-adapter/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "compile": "tsc --noEmit -p . --pretty",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src/ --fix",
    "prepare": "pnpm run typecheck"
  },
  "peerDependencies": {
    "clsx": ">=2.0.0",
    "nativewind": ">=4.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-svg": ">=15.0.0",
    "react-native-web": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "react-dom": { "optional": true },
    "react-native": { "optional": true },
    "react-native-web": { "optional": true },
    "nativewind": { "optional": true }
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "clsx": "^2.1.1",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-svg": "15.12.1",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
